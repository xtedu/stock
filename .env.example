# ---- PostgreSQL ----
POSTGRES_DB=stock
POSTGRES_USER=stock
POSTGRES_PASSWORD=change_me

# ---- 后端数据库连接（容器内地址）----
DATABASE_URL=postgresql+psycopg2://stock:change_me@db:5432/stock
REDIS_URL=redis://redis:6379/0

# ---- 鉴权 ----
SECRET_KEY=change_me_to_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 大模型（OpenAI 兼容，改 base_url/model 即可切厂商）----
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT=20
LLM_MAX_TOKENS=300

# ---- 通知通道 ----
FEISHU_WEBHOOK=
# 机器人若开了「签名校验」，把签名密钥填这里；未开启则留空
FEISHU_SECRET=
SERVER_CHAN_SENDKEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ---- 数据源 ----
TUSHARE_TOKEN=

# ---- CORS（H5 开发期）----
CORS_ORIGINS=http://localhost,http://localhost:5173
